# SkillForge Server Environment Variables Template

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/skillforge

# JWT Configuration (Required in production: use strong 256-bit random keys)
JWT_ACCESS_SECRET=replace_with_strong_random_access_secret_in_production
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Setup (Optional: required for direct video asset uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_VIDEO_DURATION_SECONDS=900
MAX_VIDEO_SIZE_MB=500

# AI Provider Setup (Optional: uses Google Gemini for career mentor; rule engine fallback active if omitted)
AI_PROVIDER=gemini
AI_API_KEY=

# Seed Accounts Passwords (Used only by npm run seed for initial demo/testing data)
SEED_ADMIN_PASSWORD=Admin@123456
SEED_INSTRUCTOR_PASSWORD=Instructor@123456
SEED_STUDENT_PASSWORD=Student@123456

