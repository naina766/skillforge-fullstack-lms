# SkillForge Server Environment Variables

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/skillforge

# JWT Configuration
JWT_ACCESS_SECRET=skillforge_super_secret_access_key_2026
JWT_REFRESH_SECRET=skillforge_super_secret_refresh_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Setup (Optional - Mock fallback enabled if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Provider Setup (Optional - Mock fallback enabled if empty)
AI_PROVIDER=gemini
AI_API_KEY=

# Seed Accounts Passwords
SEED_ADMIN_PASSWORD=Admin@123456
SEED_INSTRUCTOR_PASSWORD=Instructor@123456
SEED_STUDENT_PASSWORD=Student@123456
